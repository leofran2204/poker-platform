# Caddyfile — Reverse Proxy & Static Web File Server (HTTPS Auto-TLS)
#
# Domínio vem da env DOMAIN_NAME (docker-compose → poker_frontend).
#   Local / lab:     DOMAIN_NAME=localhost           → https://localhost
#   VPS / LE:        DOMAIN_NAME=zerotiltpoker.net → Let's Encrypt na 80/443
#   Casa + Tunnel:   NÃO use este arquivo — use Caddyfile.tunnel (Origin CA)
#                    ver DEPLOY_HOME_CLOUDFLARE.md
# CORS da API: https://zerotiltpoker.net (.env.staging / .env.tunnel).
# A porta 80, quando publicada, é usada pelo redirecionamento / ACME do Caddy.

# Healthcheck HTTP sem redirect (Docker wget usa Host: 127.0.0.1 — NÃO
# casa com http://{$DOMAIN_NAME}, o que deixava poker_frontend "unhealthy").
http://127.0.0.1 {
	handle /caddy-health {
		respond "OK" 200
	}
	respond "not found" 404
}

# HTTP público do domínio: health + redirect para HTTPS (ACME/LE na 80 via Caddy).
http://{$DOMAIN_NAME:localhost} {
	handle /caddy-health {
		respond "OK" 200
	}
	# Demais rotas HTTP → HTTPS
	redir https://{host}{uri} 308
}

{$DOMAIN_NAME:localhost} {
	# Logging estruturado em JSON para stdout
	log {
		output stdout
		format json
	}

	# Security Headers (OWASP Recommended)
	# SPA TypeScript/React (Vite): scripts e estilos do próprio origin.
	# connect-src: API same-origin + WSS.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https: wss: ws:; img-src 'self' data: blob: https:; font-src 'self' data:;"
		-Server
	}

	# Handlers explícitos são processados antes do fallback da SPA.
	handle /caddy-health {
		respond "OK" 200
	}

	# A API não publica porta no host: este é o único caminho público.
	handle /api/* {
		reverse_proxy poker_api:3000
	}

	handle /ws/* {
		reverse_proxy poker_api:3000 {
			header_up Host {host}
		}
	}

	handle /health {
		reverse_proxy poker_api:3000
	}

	# Rotas sensíveis: não indexar (WHOIS ≠ crawler, mas reduz vazamento por busca).
	@private path /admin /admin/* /wallet /wallet/* /login /register /verify-email /table/*
	handle @private {
		header X-Robots-Tag "noindex, nofollow, noarchive"
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}

	# Fallback para index.html (SPA React Router — Frontend-Web).
	handle {
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}
}
