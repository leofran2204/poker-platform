# ═══════════════════════════════════════════════════════════════════════════════
# PLATAFORMA DE POKER ONLINE — VARIÁVEIS DE AMBIENTE (.ENV)
# Copie para Infraestrutura-Docker/.env e ajuste. NUNCA commite o .env.
#
# Caminhos:
#   Lab local ........... este arquivo (.env.example)
#   Demo casa + HTTPS ... .env.tunnel.example + DEPLOY_HOME_CLOUDFLARE.md
#   VPS staging ......... .env.staging.example + DEPLOY_HETZNER.md
# Domínio do produto: zerotiltpoker.net
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Domínio público (Caddy + CORS) ───
# Local: localhost | Produto: zerotiltpoker.net (sem https://)
DOMAIN_NAME=localhost

# ─── Servidor API ───
PORT=3000
HOST=0.0.0.0
# development | staging | production — PIX real continua bloqueado em production no código
ENVIRONMENT=development

# ─── PostgreSQL (compose + API) ───
# Em staging, use senha forte e o MESMO valor em DATABASE_URL.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=poker_db
DATABASE_URL=postgres://user:password@postgres:5432/poker_db

# ─── Redis ───
REDIS_URL=redis://redis:6379

# Só ative atrás de um proxy confiável que saneie X-Forwarded-For/X-Real-IP.
TRUST_PROXY_HEADERS=true

# ─── Autenticação & Chaves Criptográficas ───
# Staging/produção: gere ≥32 bytes aleatórios (ex.: openssl rand -base64 48)
JWT_SECRET=dev-only-replace-with-a-random-secret-of-at-least-32-chars
EMAIL_CODE_PEPPER=development-email-code-pepper
AUTH_PASSWORD_WORKERS=4
# Origens HTTPS reais, separadas por vírgula. Deve bater com o domínio do Caddy.
# Local: https://localhost | Staging: https://zerotiltpoker.net
CORS_ORIGINS=https://localhost

# ─── PIX (staging seguro: mock; Asaas só sandbox autenticado) ───
# Pedir fichas (PIX manual fora do site + aprovação admin)
# Sem chave = depósito indisponível na UI (admin ainda pode ajustar saldo).
PLAY_MONEY_PIX_KEY=
PLAY_MONEY_PIX_RECEIVER_NAME=Zero Tilt
DEPOSIT_MAX_CENTS=500000
DEPOSIT_MAX_PENDING=2

# PIX_PROVIDER: mock | asaas | depix (depix somente com PIX_MODE=sandbox) (mercadopago desabilitado) — NÃO usar para jogo; PSPs bloqueiam
PIX_PROVIDER=mock
PIX_MODE=mock
PIX_WEBHOOK_SECRET=dev-only-replace-with-a-random-webhook-secret
# Opcional: restrict depositors no Asaas Sandbox (IDs internos)
# PIX_ALLOWED_DEPOSITOR_IDS=

# DePix Sandbox (PIX_PROVIDER=depix, PIX_MODE=sandbox)
# Instale segredos localmente com scripts/install-depix-local-secrets.ps1.
# Produção DePix permanece bloqueada no código.
DEPIX_API_BASE_URL=https://api.depixapp.com
DEPIX_API_KEY=
DEPIX_WEBHOOK_SECRET=
DEPIX_CALLBACK_URL=
DEPIX_REDIRECT_URL=

# Credenciais Asaas PIX (opcional se PIX_PROVIDER=asaas)
ASAAS_API_KEY=
ASAAS_SANDBOX=true

# Credenciais Mercado Pago PIX (opcional — produção desabilitada no código)
MERCADOPAGO_ACCESS_TOKEN=

# ─── Motor de Jogo & Rake ───
DEFAULT_BIG_BLIND_CENTS=2000
DEFAULT_RAKE_BASIS_POINTS=500
DEFAULT_RAKE_CAP_CENTS=10000
LOSS_DEFLATOR_ENABLED=true
