# ═══════════════════════════════════════════════════════════════════════════════
# PLATAFORMA DE POKER ONLINE — VARIÁVEIS DE AMBIENTE DE PRODUÇÃO E TESTES (.ENV)
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Ambiente local (NUNCA copie estes valores como configuração de produção) ───
PORT=3000
HOST=0.0.0.0
ENVIRONMENT=development
DATABASE_URL=postgres://user:password@postgres:5432/poker_db
REDIS_URL=redis://redis:6379
# Só ative atrás de um proxy que saneie X-Forwarded-For.
TRUST_PROXY_HEADERS=true
# Só ative atrás de um proxy que sobrescreva X-Forwarded-For/X-Real-IP.
TRUST_PROXY_HEADERS=true

# ─── Autenticação & Chaves Criptográficas ───
# Gere um segredo único de ao menos 32 caracteres para cada ambiente.
JWT_SECRET=dev-only-replace-with-a-random-secret-of-at-least-32-chars
# Em produção, CORS_ORIGINS é obrigatório e deve conter apenas origens HTTPS reais.
CORS_ORIGINS=http://localhost,https://localhost

# ─── Configuração de Gateway de Pagamentos PIX ───
# Opções para PIX_PROVIDER: asaas, mercadopago, mock
PIX_PROVIDER=mock
PIX_WEBHOOK_SECRET=dev-only-replace-with-a-random-webhook-secret

# Credenciais Asaas PIX (opcional se PIX_PROVIDER=asaas)
ASAAS_API_KEY=
ASAAS_SANDBOX=false

# Credenciais Mercado Pago PIX (opcional se PIX_PROVIDER=mercadopago)
MERCADOPAGO_ACCESS_TOKEN=

# ─── Motor de Jogo & Rake ───
DEFAULT_BIG_BLIND_CENTS=2000
DEFAULT_RAKE_BASIS_POINTS=500
DEFAULT_RAKE_CAP_CENTS=10000
LOSS_DEFLATOR_ENABLED=true
