# Caddyfile — origem HTTPS para Cloudflare Tunnel (TLS de ponta a ponta)
#
# Segurança em camadas:
#   1) Browser  ←HTTPS→  Cloudflare (certificado público Free)
#   2) cloudflared  ←canal cifrado do tunnel→  Cloudflare
#   3) Caddy no PC  ←HTTPS local :443→  cloudflared (Origin CA ou cert local)
#
# Certificados (Origin CA da Cloudflare — grátis, 15 anos):
#   SSL/TLS → Origin Server → Create Certificate
#   Salve em Infraestrutura-Docker/certs/:
#     origin.pem      (certificado)
#     origin-key.pem  (chave privada)  ← NÃO commitar
#
# Se os arquivos de cert não existirem no build/run, use o modo
# "tls internal" abaixo (self-signed): no tunnel use noTLSVerify: true
# e no painel Cloudflare SSL mode Full (não Strict).
#
# Cloudflare Tunnel Public Hostname:
#   zerotiltpoker.net → https://127.0.0.1:443
#
# CORS: https://zerotiltpoker.net

{
	admin off
}

# Preferência: certificado Origin CA (Full Strict na Cloudflare)
# Fallback documentado: troque o bloco tls por  tls internal
zerotiltpoker.net, www.zerotiltpoker.net, localhost {
	# Origin CA (monte ./certs no container). Sem os arquivos o Caddy não sobe —
	# gere-os no painel Cloudflare antes do primeiro up.
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem

	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' wss: https:; img-src 'self' data: blob: https:;"
		-Server
	}

	handle /caddy-health {
		respond "OK" 200
	}

	handle /api/* {
		reverse_proxy poker_api:3000
	}

	handle /ws/* {
		reverse_proxy poker_api:3000 {
			header_up Host {host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
		}
	}

	handle /health {
		reverse_proxy poker_api:3000
	}

	handle {
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}
}
