# Caddyfile TEMPORÁRIO — HTTPS com certificado interno (self-signed).
# Use quando Let's Encrypt estiver em rate limit (HTTP 429).
#
#   cp Caddyfile.tls-internal Caddyfile
#   docker compose up -d --force-recreate poker_frontend
#
# Browser: "Sua conexão não é privada" / ERR_CERT_AUTHORITY_INVALID
# (issuer = Caddy Local Authority). Avançar só em demo local.
#
# Após liberar o rate limit LE, volte ao Caddyfile canônico:
#   git checkout -- Caddyfile
#   docker compose up -d --force-recreate poker_frontend
# Confira: openssl s_client … | openssl x509 -noout -issuer
#   → deve mostrar "Let's Encrypt", não "Caddy Local Authority".
#
# NÃO apague o volume caddy_data a cada recreate (reestoura o limite
# de 5 certs / 168h por domínio). Ver STATUS_OPERACIONAL.json (tls_notes).
#
# Histórico: LE 429 em 2026-08-04; cert público LE obtido 2026-08-05.
# NÃO use em produção real; só para desbloquear demo.

http://127.0.0.1 {
	handle /caddy-health {
		respond "OK" 200
	}
	respond "not found" 404
}

http://{$DOMAIN_NAME:localhost} {
	handle /caddy-health {
		respond "OK" 200
	}
	redir https://{host}{uri} 308
}

{$DOMAIN_NAME:localhost} {
	# Certificado local do Caddy (não passa no Let's Encrypt)
	tls internal

	log {
		output stdout
		format json
	}

	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https: wss: ws:; img-src 'self' data: blob:; font-src 'self' data:;"
		-Server
	}

	handle /caddy-health {
		respond "OK" 200
	}

	handle /api/* {
		reverse_proxy poker_api:3000
	}

	handle /ws/* {
		reverse_proxy poker_api:3000 {
			header_up Host {host}
		}
	}

	handle /health {
		reverse_proxy poker_api:3000
	}

	handle {
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}
}
