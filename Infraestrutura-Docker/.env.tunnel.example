# ═══════════════════════════════════════════════════════════════════════════════
# DEMO EM CASA + Cloudflare Tunnel — zerotiltpoker.net
# cp .env.tunnel.example .env && (troque JWT/senhas) && chmod 600 .env  # Linux
# ═══════════════════════════════════════════════════════════════════════════════

# Caddy.tunnel escuta HTTP; o host público é o domínio no Cloudflare
DOMAIN_NAME=zerotiltpoker.net

HOST=0.0.0.0
PORT=3000
ENVIRONMENT=development

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=poker_db
DATABASE_URL=postgres://user:password@postgres:5432/poker_db

REDIS_URL=redis://redis:6379
TRUST_PROXY_HEADERS=true

JWT_SECRET=dev-only-replace-with-a-random-secret-of-at-least-32-chars
# Browser acessa via HTTPS na borda Cloudflare
CORS_ORIGINS=https://zerotiltpoker.net

PIX_PROVIDER=mock
PIX_MODE=mock
PIX_WEBHOOK_SECRET=dev-only-replace-with-a-random-webhook-secret

DEFAULT_BIG_BLIND_CENTS=2000
DEFAULT_RAKE_BASIS_POINTS=500
DEFAULT_RAKE_CAP_CENTS=10000
LOSS_DEFLATOR_ENABLED=true
