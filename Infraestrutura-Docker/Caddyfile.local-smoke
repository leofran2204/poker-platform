# Dev smoke: HTTPS local → API no host (3000) + UI estática (dist)
# API: host.docker.internal:3000 (Docker Desktop) ou gateway do WSL.

{
	# certs locais
	local_certs
}

localhost {
	tls internal

	log {
		output stdout
		format console
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' wss: https:; img-src 'self' data: blob: https:;"
		-Server
	}

	handle /caddy-health {
		respond "OK" 200
	}

	handle /api/* {
		reverse_proxy host.docker.internal:3000
	}

	handle /ws/* {
		reverse_proxy host.docker.internal:3000 {
			header_up Host {host}
		}
	}

	handle /health {
		reverse_proxy host.docker.internal:3000
	}

	handle {
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}
}
