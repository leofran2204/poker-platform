# Dev smoke: HTTPS local → API no host (3000) + UI estática (dist)
# API: host.docker.internal:3000 (Docker Desktop) ou gateway do WSL.

{
	# certs locais
	local_certs
}

localhost {
	tls internal

	log {
		output stdout
		format console
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' wss: https:; img-src 'self' data: blob: https:;"
		-Server
	}

	handle /caddy-health {
		respond "OK" 200
	}

	handle /api/* {
		reverse_proxy host.docker.internal:3000
	}

	handle /ws/* {
		reverse_proxy host.docker.internal:3000 {
			header_up Host {host}
		}
	}

	handle /health {
		reverse_proxy host.docker.internal:3000
	}

	# Vídeos e legendas das aulas só com sessão; visitante assiste só aos de
	# apresentação (episódios de história e filmes do Brazilian Pineapple).
	# A regra do site é a mesma: Frontend-Web/src/lib/course.ts (MEMBERS_ONLY_VIDEO).
	@course_media path_regexp course_media ^/videos/zt-academy-[^/]+\.(mp4|vtt)$
	handle @course_media {
		forward_auth poker_api:3000 {
			uri /api/auth/check
		}
		header Cache-Control "private, max-age=3600"
		root * /usr/share/caddy
		file_server
	}

	handle {
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}
}
