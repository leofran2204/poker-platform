# ═══════════════════════════════════════════════════════════════════════════════
# STAGING — zerotiltpoker.net
# Copie para .env na VPS:  cp .env.staging.example .env && chmod 600 .env
# Troque TODOS os valores TROCAR_*. Nunca commite o .env real.
# ═══════════════════════════════════════════════════════════════════════════════

# Host que o Caddy escuta (sem https://)
DOMAIN_NAME=zerotiltpoker.net

HOST=0.0.0.0
PORT=3000
# Staging/demo — não habilita PIX real; o código bloqueia PIX em production
ENVIRONMENT=development

POSTGRES_USER=poker_user
POSTGRES_PASSWORD=TROCAR_SENHA_FORTE_AQUI
POSTGRES_DB=poker_db
DATABASE_URL=postgres://poker_user:TROCAR_SENHA_FORTE_AQUI@postgres:5432/poker_db

REDIS_URL=redis://redis:6379
TRUST_PROXY_HEADERS=true

# openssl rand -base64 48
JWT_SECRET=TROCAR_MINIMO_32_BYTES_ALEATORIOS_USE_OPENSSL_RAND
EMAIL_CODE_PEPPER=TROCAR_MINIMO_32_BYTES_ALEATORIOS_INDEPENDENTE_DO_JWT
AUTH_PASSWORD_WORKERS=4
# Origem do browser (HTTPS obrigatório)
CORS_ORIGINS=https://zerotiltpoker.net
# Se usar www no DNS, descomente e inclua ambas:
# CORS_ORIGINS=https://zerotiltpoker.net,https://www.zerotiltpoker.net

PIX_PROVIDER=mock
PIX_MODE=mock
PIX_WEBHOOK_SECRET=TROCAR_WEBHOOK_SECRET

# Pedir fichas (PIX manual fora do site + aprovação admin) — recebedor atual
PLAY_MONEY_PIX_KEY=6eefcd53-686e-42d4-a062-03751336251c
PLAY_MONEY_PIX_RECEIVER_NAME=Leofran
DEPOSIT_MAX_CENTS=500000
DEPOSIT_MAX_PENDING=2

DEFAULT_BIG_BLIND_CENTS=2000
DEFAULT_RAKE_BASIS_POINTS=500
DEFAULT_RAKE_CAP_CENTS=10000
LOSS_DEFLATOR_ENABLED=true

# ─── E-mail de verificação (registro) ───
REQUIRE_EMAIL_VERIFICATION=true
# log = só nos logs da API | resend = e-mail real no Gmail do jogador
EMAIL_PROVIDER=resend
# Crie em https://resend.com → API Keys
RESEND_API_KEY=re_TROCAR_PELA_CHAVE
# Com domínio verificado no Resend (recomendado p/ amigos):
# EMAIL_FROM=Zero Tilt Poker <noreply@zerotiltpoker.net>
# Sem domínio: só envia para o e-mail da conta Resend (teste):
EMAIL_FROM=Zero Tilt Poker <onboarding@resend.dev>
