# Database
DATABASE_URL=postgres://user:password@localhost:5432/poker_db

# JWT secret (change in production!)
JWT_SECRET=change-me-in-production-use-32-char-min
EMAIL_CODE_PEPPER=development-email-code-pepper
AUTH_PASSWORD_WORKERS=4

# DePix Sandbox (nunca grave segredos neste arquivo versionado)
PIX_PROVIDER=mock
PIX_MODE=mock
PIX_ALLOWED_DEPOSITOR_IDS=
DEPIX_API_BASE_URL=https://api.depixapp.com
DEPIX_API_KEY=
DEPIX_WEBHOOK_SECRET=
DEPIX_CALLBACK_URL=
DEPIX_REDIRECT_URL=

# Server
HOST=0.0.0.0
PORT=3000

# CORS: somente origens HTTPS públicas; o Caddy termina TLS localmente.
CORS_ORIGINS=https://localhost
