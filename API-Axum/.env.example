# Database
DATABASE_URL=postgres://user:password@localhost:5432/poker_db

# JWT secret (change in production!)
JWT_SECRET=change-me-in-production-use-32-char-min
EMAIL_CODE_PEPPER=development-email-code-pepper
AUTH_PASSWORD_WORKERS=4

PLAY_MONEY_PIX_KEY=6eefcd53-686e-42d4-a062-03751336251c
PLAY_MONEY_PIX_RECEIVER_NAME=Leofran
DEPOSIT_MAX_CENTS=500000
DEPOSIT_MAX_PENDING=2

# DePix Sandbox (nunca grave segredos neste arquivo versionado)
PIX_PROVIDER=mock
PIX_MODE=mock
PIX_LIVE_ENABLED=false
