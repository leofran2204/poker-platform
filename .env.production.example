# ═══════════════════════════════════════════════════════════════════════════════
# PRODUÇÃO / VPS — zerotiltpoker.net (Zerotilt B2B SaaS)
# ═══════════════════════════════════════════════════════════════════════════════
#
# Uso na VPS (diretório do compose):
#   cd Infraestrutura-Docker
#   cp ../.env.production.example .env   # ou .env.staging.example para demo
#   chmod 600 .env
#   # edite TODOS os TROCAR_*
#   docker compose up -d --build
#
# Portas públicas: 80/443 apenas. Postgres (5433) e Redis (6379) ficam em 127.0.0.1.
# Nunca commite o .env real.
#
# ⚠️ Limites do produto (sem certificação de produção):
#   - PIX real/payout permanecem bloqueados quando ENVIRONMENT=production
#   - Para demo/staging com mock, use ENVIRONMENT=development e PIX_MODE=mock
#   - Mesas: dono único por processo (1 réplica da API)
# ═══════════════════════════════════════════════════════════════════════════════

# Host que o Caddy escuta (sem https://)
DOMAIN_NAME=zerotiltpoker.net

HOST=0.0.0.0
PORT=3000

# production = API rejeita PIX real (seguro). development = demo/staging com mock.
ENVIRONMENT=production

# Origens do browser (HTTPS obrigatório na API)
CORS_ORIGINS=https://zerotiltpoker.net
# White-label por subdomínio (liste explicitamente):
# CORS_ORIGINS=https://zerotiltpoker.net,https://www.zerotiltpoker.net,https://clube1.zerotiltpoker.net

# ─── PostgreSQL 15 (rede interna do Compose) ───
POSTGRES_USER=zerotilt_admin
POSTGRES_PASSWORD=TROCAR_SENHA_FORTE_MINIMO_32_CHARS
POSTGRES_DB=poker_b2b_db
DATABASE_URL=postgres://zerotilt_admin:TROCAR_SENHA_FORTE_MINIMO_32_CHARS@postgres:5432/poker_b2b_db

# ─── Redis 7 ───
REDIS_URL=redis://redis:6379
TRUST_PROXY_HEADERS=true

# ─── Segurança (openssl rand -base64 48) ───
JWT_SECRET=TROCAR_MINIMO_32_BYTES_ALEATORIOS_USE_OPENSSL_RAND
EMAIL_CODE_PEPPER=TROCAR_MINIMO_32_BYTES_ALEATORIOS_INDEPENDENTE_DO_JWT
AUTH_PASSWORD_WORKERS=4
PIX_WEBHOOK_SECRET=TROCAR_WEBHOOK_SECRET_ALEATORIO

# ─── Verificação de e-mail ───
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_TROCAR_PELA_CHAVE
EMAIL_FROM=Zero Tilt Poker <noreply@zerotiltpoker.net>


# ─── PIX (mock padrão; sandbox só com allow-list e ENVIRONMENT!=production) ───
PIX_PROVIDER=mock
PIX_MODE=mock
# PIX_ALLOWED_DEPOSITOR_IDS=

# ─── Defaults de mesa (valores em centavos inteiros) ───
DEFAULT_BIG_BLIND_CENTS=2000
DEFAULT_RAKE_BASIS_POINTS=500
DEFAULT_RAKE_CAP_CENTS=10000
LOSS_DEFLATOR_ENABLED=true
