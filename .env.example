# ═══════════════════════════════════════════════════════════════════════════════
# PLATAFORMA DE POKER ONLINE — VARIÁVEIS DE AMBIENTE DE PRODUÇÃO E TESTES (.ENV)
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Servidor API & Banco de Dados ───
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://poker_user:poker_password_prod@postgres:5432/poker_db
REDIS_URL=redis://redis:6379

# ─── Autenticação & Chaves Criptográficas ───
JWT_SECRET=super_secret_jwt_signing_key_production_32bytes_min!
ALLOWED_ORIGINS=http://localhost:8080,https://pokerplatform.com

# ─── Configuração de Gateway de Pagamentos PIX ───
# Opções para PIX_PROVIDER: asaas, mercadopago, mock
PIX_PROVIDER=asaas
PIX_WEBHOOK_SECRET=poker-pix-webhook-secret-key-production-32chars

# Credenciais Asaas PIX (opcional se PIX_PROVIDER=asaas)
ASAAS_API_KEY=$aact_YTU5YTE0MzA2NTM5NGYyMGNhMGU0YTBo...
ASAAS_SANDBOX=false

# Credenciais Mercado Pago PIX (opcional se PIX_PROVIDER=mercadopago)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-1234567890123456-072400-abcdef...

# ─── Motor de Jogo & Rake ───
DEFAULT_BIG_BLIND=20.0
DEFAULT_RAKE_PCT=5.0
DEFAULT_RAKE_CAP=100.0
LOSS_DEFLATOR_ENABLED=true
