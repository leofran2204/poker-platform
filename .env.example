# ═══════════════════════════════════════════════════════════════════════════════
# PLATAFORMA DE POKER ONLINE — TEMPLATE DE VARIÁVEIS DE AMBIENTE
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Servidor API & Banco de Dados ───
PORT=3000
HOST=0.0.0.0
# Substitua credenciais e segredos por valores exclusivos fora do repositório.
DATABASE_URL=postgres://poker_user:change-me@postgres:5432/poker_db
REDIS_URL=redis://redis:6379

# ─── Autenticação & Chaves Criptográficas ───
JWT_SECRET=change-me-before-production-with-at-least-32-random-bytes
# A API lê CORS_ORIGINS e aceita somente origens HTTPS explícitas.
CORS_ORIGINS=https://localhost,https://pokerplatform.com

# ─── PIX (adiado — adaptadores locais permanecem em modo seguro) ───
# Não habilite um provedor real sem autorização de escopo, credenciais secretas
# fora do repositório e validação específica de pagamentos.
PIX_PROVIDER=mock
PIX_WEBHOOK_SECRET=change-me-before-enabling-pix

# Credenciais reservadas para futura integração PIX (mantenha vazias).
ASAAS_API_KEY=
ASAAS_SANDBOX=true
MERCADOPAGO_ACCESS_TOKEN=

# ─── Motor de Jogo & Rake ───
# Valores monetários inteiros para futuros consumidores de configuração.
DEFAULT_BIG_BLIND_CENTS=2000
DEFAULT_RAKE_BASIS_POINTS=500
DEFAULT_RAKE_CAP_CENTS=10000
LOSS_DEFLATOR_ENABLED=true
