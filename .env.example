# ═══════════════════════════════════════════════════════════════════════════════
# PLATAFORMA DE POKER ONLINE — TEMPLATE DE VARIÁVEIS DE AMBIENTE
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Servidor API & Banco de Dados ───
PORT=3000
HOST=0.0.0.0
# Substitua credenciais e segredos por valores exclusivos fora do repositório.
DATABASE_URL=postgres://poker_user:change-me@postgres:5432/poker_db
REDIS_URL=redis://redis:6379

# ─── Autenticação & Chaves Criptográficas ───
JWT_SECRET=change-me-before-production-with-at-least-32-random-bytes
EMAIL_CODE_PEPPER=development-email-code-pepper
AUTH_PASSWORD_WORKERS=4
# A API lê CORS_ORIGINS e aceita somente origens HTTPS explícitas.
CORS_ORIGINS=https://localhost,https://pokerplatform.com

# ─── PIX (mock por padrão; sandbox restrito para testes autorizados) ───
# PIX_PROVIDER=mock e PIX_MODE=mock não fazem qualquer chamada externa.
PIX_PROVIDER=mock
PIX_MODE=mock
PIX_WEBHOOK_SECRET=change-me-before-enabling-pix

# Para testar o Asaas Sandbox com a sua própria conta, configure todos os campos
# abaixo fora do repositório e informe somente o UUID da sua conta no allow-list.
# PIX_PROVIDER=asaas
# PIX_MODE=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_TEST_CUSTOMER_ID=
PIX_ALLOWED_DEPOSITOR_IDS=

# O modo production é rejeitado intencionalmente pelo código. Não existem
# credenciais de produção neste projeto até aprovação do PSP compatível e
# controles de operação com dinheiro real estarem implementados e validados.

# ─── Motor de Jogo & Rake ───
# Valores monetários inteiros para futuros consumidores de configuração.
DEFAULT_BIG_BLIND_CENTS=2000
DEFAULT_RAKE_BASIS_POINTS=500
DEFAULT_RAKE_CAP_CENTS=10000
LOSS_DEFLATOR_ENABLED=true
