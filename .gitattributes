# Normalize text files in Git and keep cross-platform source files on LF.
.gitattributes text eol=lf
* text=auto

*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
Caddyfile text eol=lf

# Windows command scripts require CRLF for broad compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# The new film fingerprints these text assets as bytes on every platform.
ZeroTiltCurso/editorial/pineapple-transcript.txt text eol=lf
Frontend-Web/public/videos/zt-brazilian-pineapple-hybrid-v1.vtt text eol=lf
