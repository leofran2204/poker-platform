{
  "name": "zero-tilt-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Zero Tilt Poker — frontend TypeScript (Full Tilt inspired)",
  "scripts": {
    "audit:security": "npm audit --audit-level=high",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit && eslint src",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.1",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
