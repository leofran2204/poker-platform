localhost {
    log

    # ─── Security Headers (OWASP Hardening) ───
    header {
        # Previne MIME-type sniffing
        X-Content-Type-Options "nosniff"
        # Impede Clickjacking incorporando em iframes
        X-Frame-Options "DENY"
        # Ativa proteção contra Cross-Site Scripting (XSS) no navegador
        X-XSS-Protection "1; mode=block"
        # Força comunicação HTTPS por 1 ano (HSTS)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Controla quais informações de referrer são enviadas
        Referrer-Policy "strict-origin-when-cross-origin"
        # Content Security Policy (CSP) para WebAssembly + Dioxus
        Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' ws: wss:; img-src 'self' data:;"
        # Desativa identificação do servidor
        -Server
    }

    # Limite máximo de corpo de requisição (WAF Payload Protection - Max 10MB)
    request_body {
        max_size 10MB
    }

    # Encaminha chamadas de API para o container backend
    handle /api/* {
        reverse_proxy poker_api:3000 {
            header_up Host {host}
        }
    }

    # Health check público, sem depender do prefixo /api.
    handle /health {
        reverse_proxy poker_api:3000
    }

    # Encaminha chamadas de WebSockets para o container backend
    handle /ws/* {
        reverse_proxy poker_api:3000 {
            header_up Host {host}
        }
    }

    # Serve arquivos estáticos do Frontend Dioxus (WASM)
    handle {
        root * /usr/share/caddy
        try_files {path} /index.html
        file_server
    }
}
